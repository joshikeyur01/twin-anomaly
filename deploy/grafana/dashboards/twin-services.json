{
  "__comment": "Status row formula: min(up) * (min(twin_service_ready) or vector(1)). up=0 catches a dead container; ready=0 catches alive-but-degraded. The or-vector(1) guard matters: when a target dies its ready gauge goes STALE (empty), a bare product becomes empty too, and lastNotNull would reach back to the pre-death READY. vector(1) keeps the product a real 0.",
  "title": "twin-anomaly \u00b7 UR5",
  "uid": "twin-services",
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "telemetry-svc",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{instance=\"telemetry-svc:8001\"}) * (min(twin_service_ready{service=\"telemetry-svc\"}) or vector(1))"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      }
    },
