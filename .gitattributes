# Model artefacts are binary; git-lfs carries them (install git-lfs before
# cloning, or `git lfs pull` after).
models/** filter=lfs diff=lfs merge=lfs -text

# Manifests stay plain git: they are small JSON, and `git log -p models/`
# must show metric diffs — an opaque LFS pointer would defeat the point of
# one chore(models) commit per artefact.
models/**/*.json !filter !diff !merge text

# Parquet test fixtures are small and binary; plain git, no eol mangling.
data/fixtures/** -text
