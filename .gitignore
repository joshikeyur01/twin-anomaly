# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# NOTE: contracts/src/contracts/gen/ (importable as contracts.gen) is checked
# in on purpose (inherited ADR — see twin-services 0003). Never add it here.

# Datasets are regenerable by construction (just collect && just dataset).
# Only the small test fixtures ship with the repo.
# data/* not data/ — git cannot re-include a path inside a fully-excluded
# directory, and the test fixtures under data/fixtures/ must ship.
data/*
!data/fixtures/

# NOTE: models/ is NOT ignored — artefacts are versioned via git-lfs
# (see .gitattributes); manifests diff as plain JSON.

# Notebooks
.ipynb_checkpoints/

# Node (viz-svc frontend)
node_modules/
services/viz-svc/frontend/dist/

# ROS
install/
log/

# Container volumes (bind mounts)
deploy/**/data/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Env
.env
.env.local
